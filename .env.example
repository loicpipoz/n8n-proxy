# Tailscale
TS_AUTHKEY=tskey-auth-REPLACE_ME
TAILSCALE_VERSION=latest
TAILSCALE_HOSTNAME=n8n-wh01
TS_EXTRA_ARGS="--ssh --accept-dns=false"

# Public hostname served directly by Caddy.
PUBLIC_DOMAIN=n8n-wh01.spiritviews.com

# Use Caddyfile.direct-n8n-public for a DNS-only public edge, or
# Caddyfile.direct-n8n with a Cloudflare Origin CA certificate.
CADDY_SITE_ADDRESS=n8n-wh01.spiritviews.com

# Private n8n target reachable from the proxy through the tailnet.
N8N_UPSTREAM_URL=https://100.110.202.6

# Host header and TLS SNI used when proxying to n8n. If N8N_UPSTREAM_URL uses
# an IP, keep these set to the original n8n hostname.
N8N_UPSTREAM_HOST=n8n.monkey-eel.ts.net
N8N_UPSTREAM_TLS_SERVER_NAME=n8n.monkey-eel.ts.net

# Webhook allowlist. Keep this narrow; all other paths return 404.
# GET serves browser modules, POST handles actions, and OPTIONS supports CORS
# preflight. Test webhooks are intentionally not exposed in production.
WEBHOOK_METHODS="GET POST OPTIONS"
WEBHOOK_PATHS="/webhook/0key/*"

# n8n Form Trigger allowlist. Forms are browser-facing, so GET is needed to
# render pages and POST is needed to submit them. Wait/Form and Send and Wait
# resume callbacks are also forwarded by config/Caddyfile on /form-waiting/*
# and /webhook-waiting/*.
FORM_METHODS="GET POST"
# Remove /form-test before the production launch if it is no longer required.
FORM_PATHS="/form/* /form-test/* /form-waiting/*"

# Leave public only when providers do not publish stable source ranges. When
# Cloudflare proxying is active, replace this with the official Cloudflare CIDRs.
ALLOWED_SOURCE_CIDRS="0.0.0.0/0 ::/0"

# Legacy NPM deployments only. Direct Caddy configurations ignore this value.
NPM_EDGE_KEY=

# Select Caddyfile.direct-n8n for a direct n8n-only edge, or
# Caddyfile.direct-combined when this host also serves the RustDesk console.
# Direct mode must only be enabled after TLS and firewall validation.
CADDY_CONFIG_FILE=Caddyfile.direct-n8n-public
TRUSTED_PROXY_CIDRS="127.0.0.1/32"
N8N_ORIGIN_CERT_FILE=/etc/caddy/origin/n8n-wh01.pem
N8N_ORIGIN_KEY_FILE=/etc/caddy/origin/n8n-wh01.key
N8N_PUBLIC_CERT_FILE=/etc/caddy/origin/n8n-wh01-public.pem
N8N_PUBLIC_KEY_FILE=/etc/caddy/origin/n8n-wh01-public.key
CADDY_ORIGIN_CERT_DIR=./secrets/origin
RUSTDESK_SITE_ADDRESS=rd01.spiritviews.com
RUSTDESK_WEB_UPSTREAM=http://host.docker.internal:21114
RUSTDESK_ID_WS_UPSTREAM=http://host.docker.internal:21118
RUSTDESK_RELAY_WS_UPSTREAM=http://host.docker.internal:21119
RUSTDESK_CERT_FILE=/etc/caddy/origin/rd01.pem
RUSTDESK_KEY_FILE=/etc/caddy/origin/rd01.key
# Compatibility for clients whose API URL is https://rd01...:21114.
# The public 21114 port is redirected by deploy/rustdesk-tls-21114.service.
RUSTDESK_TLS_SHIM_BIND=0.0.0.0
RUSTDESK_TLS_SHIM_PORT=22114

# Request body limit before proxying to n8n.
MAX_BODY_SIZE=10MB

# Internal path used by Caddy. Keep this unless you change the volume mount.
CADDY_LOG_DIR=/var/log/caddy

# Direct public bind addresses.
HTTP_BIND=0.0.0.0
HTTPS_BIND=0.0.0.0

HTTP_PORT=80
HTTPS_PORT=443
